{
  "name": "personal-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16" },
  "bin": { "pag": "./src/cli.ts" },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts serve",
